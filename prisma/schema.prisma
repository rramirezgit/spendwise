generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  name          String?
  image         String?
  emailVerified DateTime?
  accounts      Account[]
  sessions      Session[]
  ownedGroups   Group[]         @relation("GroupOwner")
  memberships   GroupMember[]
  budgetPaid    BudgetExpense[] @relation("BudgetPayer")
  fixedPaid     FixedItem[]     @relation("FixedPayer")
  savingsBy     GroupSaving[]   @relation("SavingBy")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Group {
  id         String          @id @default(cuid())
  name       String
  inviteCode String          @unique
  createdAt  DateTime        @default(now())
  ownerId    String
  owner      User            @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members    GroupMember[]
  fixedItems FixedItem[]
  expenses   BudgetExpense[]
  savings    GroupSaving[]
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  joinedAt DateTime @default(now())
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model FixedItem {
  id        String   @id @default(cuid())
  groupId   String
  name      String
  amount    Int
  category  String
  payerId   String?
  splitPaid Boolean  @default(false)
  sortOrder Int      @default(0)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payer     User?    @relation("FixedPayer", fields: [payerId], references: [id])

  @@index([groupId])
}

model BudgetExpense {
  id          String    @id @default(cuid())
  groupId     String
  month       String
  name        String
  amount      Int
  category    String
  note        String?
  payerId     String?
  splitPaid   Boolean   @default(false)
  paid        Boolean   @default(false)
  paidAt      DateTime?
  isFixed     Boolean   @default(false)
  fixedItemId String?
  spentAt     DateTime  @default(now())
  createdAt   DateTime  @default(now())
  group       Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payer       User?     @relation("BudgetPayer", fields: [payerId], references: [id])

  @@index([groupId, month])
}

model GroupSaving {
  id        String   @id @default(cuid())
  groupId   String
  amount    Int
  kind      String   @default("deposit")
  note      String?
  byUserId  String?
  savedAt   DateTime @default(now())
  createdAt DateTime @default(now())
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  by        User?    @relation("SavingBy", fields: [byUserId], references: [id])

  @@index([groupId, savedAt])
}
