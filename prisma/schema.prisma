generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String             @id @default(cuid())
  email         String             @unique
  name          String?
  image         String?
  emailVerified DateTime?
  accounts      Account[]
  sessions      Session[]
  expenses      Expense[]
  incomes       Income[]
  recurring     RecurringExpense[]
  plans         Installment[]
  fixedPayments FixedPayment[]
  savings       Saving[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Expense {
  id        String   @id @default(cuid())
  amount    Int
  note      String?
  category  String
  spentAt   DateTime @default(now())
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, spentAt])
}

model Income {
  id         String   @id @default(cuid())
  amount     Int
  source     String?
  recurring  Boolean  @default(false)
  receivedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, receivedAt])
}

model RecurringExpense {
  id        String         @id @default(cuid())
  amount    Int
  category  String
  note      String?
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments  FixedPayment[]

  @@index([userId])
}

model FixedPayment {
  id          String           @id @default(cuid())
  recurringId String
  month       String
  paidAt      DateTime         @default(now())
  userId      String
  recurring   RecurringExpense @relation(fields: [recurringId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([recurringId, month])
  @@index([userId, month])
}

model Installment {
  id          String   @id @default(cuid())
  description String
  totalAmount Int
  count       Int
  startMonth  DateTime @default(now())
  category    String
  createdAt   DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Saving {
  id        String   @id @default(cuid())
  amount    Int
  note      String?
  kind      String   @default("deposit")
  savedAt   DateTime @default(now())
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, savedAt])
}
